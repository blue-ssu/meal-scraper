{
  "name": "@bluessu/meal-scraper",
  "private": false,
  "version": "0.1.1",
  "description": "A meal menu scraper for dormitory meal info.",
  "type": "commonjs",
  "author": "bluessu",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/blue-ssu/meal-scraper#readme",
  "keywords": [
    "ssu",
    "soongsil",
    "meal",
    "scraper",
    "dormitory",
    "typescript",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blue-ssu/meal-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/blue-ssu/meal-scraper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "funding": "https://github.com/blue-ssu/meal-scraper",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup",
    "clean": "rimraf dist",
    "prepare": "pnpm run build",
    "quality": "pnpm run clean && pnpm run typecheck && pnpm run build",
    "prepublishOnly": "pnpm run quality",
    "prepack": "pnpm run quality",
    "release:patch": "pnpm version patch && pnpm publish --access public",
    "release:minor": "pnpm version minor && pnpm publish --access public",
    "release:major": "pnpm version major && pnpm publish --access public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "openai": "^4.57.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "rimraf": "^5.0.9",
    "typescript": "^5.5.4",
    "@types/node": "^22.7.1"
  }
}
