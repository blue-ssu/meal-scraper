{
  "name": "@bluessu/meal-scraper",
  "private": false,
  "version": "0.1.0",
  "description": "A meal menu scraper for dormitory meal info.",
  "type": "commonjs",
  "author": "bluessu",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/blue-ssu/meal-scraper#readme",
  "keywords": [
    "ssu",
    "soongsil",
    "meal",
    "scraper",
    "dormitory",
    "typescript",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blue-ssu/meal-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/blue-ssu/meal-scraper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "prepack": "npm run clean && npm run build",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "openai": "^4.57.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.9",
    "typescript": "^5.5.4",
    "@types/node": "^22.7.1"
  }
}
